# Copy this file to .env and provide a newly rotated Groq API key.
GROQ_API_KEY=

# Comma-separated origins allowed to call the API in production.
LUNA_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Protects the memory administration endpoints. Generate a long random value.
LUNA_ADMIN_API_TOKEN=
